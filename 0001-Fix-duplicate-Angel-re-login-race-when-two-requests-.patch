From 8b8748ec457093839ca7cc9a82ca77df65bf1a79 Mon Sep 17 00:00:00 2001
From: Kartikya Motwani <kartikya@local>
Date: Sun, 30 Aug 2026 15:02:37 +0000
Subject: [PATCH] Fix duplicate Angel re-login race when two requests hit an
 expired token together

Live logs today showed two separate real logins (two "smartConnect:121
in pool" entries a second apart) when an ltpData call and a
getCandleData call both hit an expired session at roughly the same
moment. Both succeeded on retry - not broken - but wasteful, and in
the worst case this kind of churn (repeatedly invalidating and
recreating sessions) could make transient invalid-token errors more
frequent, not less.

Root cause: _reset_session() unconditionally set _smart_api = None
with no way to tell "is the session I'm about to clear actually the
same one that failed, or did someone else already fix it." Sequence:
request A fails, resets, logs in fresh; request B (which independently
failed around the same time, holding a reference to the OLD session
from before A's fix) then also calls reset - clobbering A's
just-established fresh session - and logs in again unnecessarily.

Fix: _reset_session(stale_api=...) now only actually clears _smart_api
if it's still the same object that triggered the failure (compare-and-
swap under the existing lock). If another request already replaced it
with a fresh session, this becomes a no-op instead of forcing a
duplicate login. Updated all three call sites (_fetch_ltp,
get_angel_ohlc/_get_ohlc_by_token, get_angel_ltp_bulk) to pass their
local `api` reference.

Verified by directly simulating the exact race: two resets both
holding the same originally-stale reference, with a fresh session
established in between - confirmed the second reset does NOT clobber
the fresh session. All 17 existing tests still pass.
---
 app/services/angel_feed.py | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/app/services/angel_feed.py b/app/services/angel_feed.py
index a240987..e431d12 100644
--- a/app/services/angel_feed.py
+++ b/app/services/angel_feed.py
@@ -182,10 +182,19 @@ def _get_session():
         return _smart_api
 
 
-def _reset_session():
+def _reset_session(stale_api=None):
+    """Only actually clears the session if it's still the same object that
+    triggered the failure. Two requests can hit an expired token around
+    the same moment (seen live: an ltpData call and a getCandleData call
+    both failing within the same second) - without this guard, both would
+    reset+relogin independently, with the second reset clobbering the
+    first request's already-fresh session and forcing a wasted duplicate
+    login. Passing the stale `api` reference each caller was using makes
+    this a no-op if someone else already refreshed it."""
     global _smart_api
     with _session_lock:
-        _smart_api = None
+        if stale_api is None or _smart_api is stale_api:
+            _smart_api = None
 
 
 _AUTH_ERROR_CODES = {"AG8001", "AG8002"}  # Invalid Token / Token expired, per Angel's error codes
@@ -221,7 +230,7 @@ def _fetch_ltp(symbol: str) -> dict:
 
     if resp is None or (not _is_success(resp) and _is_auth_error(resp) and not retried):
         logger.warning(f"Angel session looks invalid/expired for {symbol} ({resp}), re-logging in and retrying once.")
-        _reset_session()
+        _reset_session(stale_api=api)
         api = _get_session()
         resp = api.ltpData("NSE", tradingsymbol, token)
         retried = True
@@ -316,7 +325,7 @@ def _get_ohlc_by_token(token: str, period: str = "1y", label: str = "") -> list:
 
     if not _is_success(resp) and _is_auth_error(resp):
         logger.warning(f"Angel session looks invalid/expired fetching OHLC for {label or token}, re-logging in and retrying once.")
-        _reset_session()
+        _reset_session(stale_api=api)
         api = _get_session()
         resp = _call_candle_data_with_retry(api, params, label or token)
 
@@ -405,7 +414,7 @@ def get_angel_ltp_bulk(symbols: list) -> dict:
 
         if not _is_success(resp) and _is_auth_error(resp):
             logger.warning("Angel session looks invalid/expired for bulk LTP fetch, re-logging in and retrying once.")
-            _reset_session()
+            _reset_session(stale_api=api)
             api = _get_session()
             try:
                 resp = api.getMarketData(params["mode"], params["exchangeTokens"])
