--- a/src/lib/api.ts
+++ b/src/lib/api.ts
@@ -169,6 +169,23 @@ export const meApi = {
     authRequest<T>(path, { method: "POST", body: body ?? {}, query }),
 };
 
+/**
+ * BUG FIX: bot_runner.py's start/stop/reset all return HTTP 200 even when
+ * the *action itself* failed (e.g. {"status": false, "reason":
+ * "already_running"}). authRequest only checks the HTTP status code, so
+ * these business-logic failures were silently treated as success -
+ * "Start Bot" would show a green "Bot start requested" toast and nothing
+ * would actually happen, with no visible error anywhere. This surfaces
+ * that failure properly so the real reason shows up as an error toast
+ * instead of a false-positive success.
+ */
+function assertActionSuccess<T extends { status?: boolean; reason?: string }>(result: T): T {
+  if (result?.status === false) {
+    throw new ApiError(result.reason ?? "Action failed for an unknown reason.", 200);
+  }
+  return result;
+}
+
 export interface AuthResponse {
   access_token: string;
   token_type?: string;
@@ -582,16 +599,17 @@ export const fetchStockInfo = async (symbol: string) =>
 
 
 export const startBot = (body: Record<string, unknown>) =>
-  meApi.post("/me/bot/start", undefined, {
+  meApi.post<{ status?: boolean; reason?: string }>("/me/bot/start", undefined, {
     symbols: Array.isArray(body['symbols'])
       ? (body['symbols'] as unknown[]).join(",")
       : String(body['symbols'] ?? ""),
     strategy: String(body['strategy'] ?? ""),
     tick_seconds: Number(body['tick_seconds'] ?? body['interval_seconds'] ?? 60),
     starting_capital: Number(body['starting_capital'] ?? 100000),
-  });
-export const stopBot = () => meApi.post("/me/bot/stop", {});
-export const resetAccount = () => meApi.post("/me/account/reset", undefined, { confirm: true });
+  }).then(assertActionSuccess);
+export const stopBot = () => meApi.post<{ status?: boolean; reason?: string }>("/me/bot/stop", {}).then(assertActionSuccess);
+export const resetAccount = () =>
+  meApi.post<{ status?: boolean; reason?: string }>("/me/account/reset", undefined, { confirm: true }).then(assertActionSuccess);
 export const runBacktest = async (body: Record<string, unknown>) =>
   normalizeBacktest(await api.post("/backtest/historical", undefined, {
     strategy: String(body['strategy'] ?? ""),
