+def _warm_start_price_history(strategies: dict, symbols: list, lookback_days: int = 30):
+    """
+    BUG FIX: previously, every bot restart reset each strategy's internal
+    price deque to empty, forcing a fresh ~3-week (15+ trading day) cold
+    start before RSI could produce anything but None -> HOLD, even though
+    the live decision cadence is only once/day. This silently made every
+    restart erase weeks of real signal-readiness.
+
+    Fix: on start(), seed each strategy's price history directly from real
+    historical daily closes (same data source the backtest itself uses),
+    so RSI is meaningful from day one after a restart instead of after
+    another cold-start period. Best-effort per symbol - a single symbol's
+    fetch failure (e.g. a newly-listed or recently-renamed ticker with
+    little history) doesn't block startup for the rest of the watchlist;
+    that symbol just falls back to warming up live, same as before this fix.
+    """
+    for symbol in symbols:
+        strategy = strategies.get(symbol)
+        if strategy is None or not hasattr(strategy, "prices"):
+            continue  # strategy doesn't use a price-history deque at all
+        try:
+            ticker = yf.Ticker(f"{symbol.upper()}.NS")
+            hist = ticker.history(period=f"{lookback_days}d", interval="1d")
+            closes = [float(c) for c in hist["Close"].tolist() if c == c]  # drop NaN
+            for close in closes:
+                strategy.prices.append(close)
+            if closes:
+                logger.info(f"Warm-started {symbol} strategy history with {len(closes)} historical daily closes")
+        except Exception as e:
+            logger.warning(f"Could not warm-start price history for {symbol}, will build up live instead: {e}")
+
 # Default watchlist. Starting prices are just seeds for the simulated feed -
 # irrelevant once real Angel One data replaces it.
 DEFAULT_WATCHLIST = {
@@ -244,6 +277,7 @@ class BotRunner:
         self.symbols = symbols
         self.strategy_name = strategy_name
         self.strategies = {sym: strategy_cls() for sym in symbols}
+        _warm_start_price_history(self.strategies, symbols)
         self.tick_seconds = tick_seconds
         self.last_signal = {sym: "HOLD" for sym in symbols}
         self.last_decision_date = {}
@@ -325,12 +359,29 @@ class BotRunner:
                         # would mean the live bot trades a different, never-
