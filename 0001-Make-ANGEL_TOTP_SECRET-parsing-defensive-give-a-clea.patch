From 211160388c647050be8263edd3a82314f2e8f8d7 Mon Sep 17 00:00:00 2001
From: Kartikya Motwani <kartikya@local>
Date: Mon, 24 Aug 2026 09:25:41 +0000
Subject: [PATCH] Make ANGEL_TOTP_SECRET parsing defensive + give a clearer
 error

Live test today hit 'Non-base32 digit found' - pyotp.TOTP() rejecting
whatever is currently in ANGEL_TOTP_SECRET on Render. Common causes:
trailing whitespace/newline from copy-pasting into Render's env var
box, or lowercase letters. Now strips whitespace and uppercases before
handing it to pyotp, and if it's still invalid, raises a clear error
explaining what a valid value looks like instead of just surfacing
pyotp's raw exception text. Doesn't fix a wrong secret value itself -
that still needs to be re-copied correctly - but removes the most
common copy-paste failure modes and makes the actual problem obvious
in the logs if it's something else.
---
 app/services/angel_feed.py | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/app/services/angel_feed.py b/app/services/angel_feed.py
index 6e211f8..caa0079 100644
--- a/app/services/angel_feed.py
+++ b/app/services/angel_feed.py
@@ -124,7 +124,17 @@ def _get_session():
             )
 
         api = SmartConnect(api_key=settings.ANGEL_API_KEY)
-        totp = pyotp.TOTP(settings.ANGEL_TOTP_SECRET).now()
+        totp_secret = settings.ANGEL_TOTP_SECRET.strip().replace(" ", "").upper()
+        try:
+            totp = pyotp.TOTP(totp_secret).now()
+        except Exception as e:
+            raise RuntimeError(
+                f"ANGEL_TOTP_SECRET doesn't look like a valid base32 TOTP secret "
+                f"(got a {len(totp_secret)}-char value). Re-copy it from the SmartAPI "
+                f"portal's 2FA/TOTP setup screen - it should be a short (usually "
+                f"16-32 char) string of only A-Z and 2-7, no spaces or '='. "
+                f"Original error: {e}"
+            )
         session = api.generateSession(settings.ANGEL_CLIENT_ID, settings.ANGEL_PASSWORD, totp)
         if not session.get("status"):
             raise RuntimeError(f"Angel One login failed: {session}")
